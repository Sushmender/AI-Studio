# CHOOSE : OPENROUTER , GROQ
LLM_PROVIDER=OPENROUTER

# ── Provider API Keys (required) ─────────────────────────────────────────────
FAL_KEY=your_fal_key_here
REPLICATE_API_TOKEN=your_replicate_api_token_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Model IDs (optional — defaults shown) ────────────────────────────────────
FAL_IMAGE_MODEL=fal-ai/flux/dev
REPLICATE_VIDEO_MODEL=luma/ray-flash-2-720p
GROQ_MODEL=qwen/qwen3.8-27b
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ── Mocking (set False to hit real APIs) ─────────────────────────────────────
# Groq is ALWAYS called for real (free tier — no cost to analyse/synthesize).
# Only fal.ai and Replicate are mocked when True.
MOCK_GENERATION_APIS=True

# ── Timeouts (seconds) ───────────────────────────────────────────────────────
FAL_TIMEOUT=30
REPLICATE_TIMEOUT=360
GROQ_TIMEOUT=10

# ── Retry ────────────────────────────────────────────────────────────────────
MAX_RETRY_ATTEMPTS=2
RETRY_BACKOFF_BASE=1.5

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# ── CORS (comma-separated list) ───────────────────────────────────────────────
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
